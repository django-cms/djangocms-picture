#: apps.py:7
msgid "django CMS Picture"
msgstr "django CMS 圖片"

#: cms_plugins.py:23
msgid "Image"
msgstr "圖片"

#: cms_plugins.py:33 models.py:158
msgid "Attributes"
msgstr "屬性"

#: cms_plugins.py:43
msgid "Cropping"
msgstr "裁切"

#: cms_plugins.py:51 models.py:189
msgid "Link"
msgstr "連結"

#: fields.py:110
msgid "Select a valid image source."
msgstr "請選擇有效的圖片來源。"

#: fields.py:111
msgid "Select an image from this source."
msgstr "請從此來源選擇一張圖片。"

#: fields.py:144 forms.py:19 forms.py:53 models.py:97
msgid "Image source"
msgstr "圖片來源"

#: models.py:45
msgid "Align left"
msgstr "靠左對齊"

#: models.py:46
msgid "Align right"
msgstr "靠右對齊"

#: models.py:47
msgid "Align center"
msgstr "置中對齊"

#: models.py:56
msgid "Default"
msgstr "預設"

#: models.py:73
msgid "Open in new window"
msgstr "在新視窗中開啟"

#: models.py:74
msgid "Open in same window"
msgstr "在同一視窗中開啟"

#: models.py:75
msgid "Delegate to parent"
msgstr "交由父視窗處理"

#: models.py:76
msgid "Delegate to top"
msgstr "交由頂層視窗處理"

#: models.py:80
msgid "Let settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES decide"
msgstr "由 settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES 決定"

#: models.py:81
msgid "Yes"
msgstr "是"

#: models.py:82
msgid "No"
msgstr "否"

#: models.py:91
msgid "Template"
msgstr "範本"

#: models.py:103
msgid "Image model"
msgstr "圖片模型"

#: models.py:110
msgid "Image object ID"
msgstr "圖片物件 ID"

#: models.py:121
msgid "Image source configuration"
msgstr "圖片來源設定"

#: models.py:127
msgid "Width"
msgstr "寬度"

#: models.py:131
msgid "The image width as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "圖片寬度，以像素數表示。例如：\"720\"，而不是 \"720px\"。"

#: models.py:136
msgid "Height"
msgstr "高度"

#: models.py:140
msgid "The image height as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "圖片高度，以像素數表示。例如：\"720\"，而不是 \"720px\"。"

#: models.py:145
msgid "Alignment"
msgstr "對齊方式"

#: models.py:149
msgid "Aligns the image according to the selected option."
msgstr "依照所選選項對齊圖片。"

#: models.py:152
msgid "Caption text"
msgstr "說明文字"

#: models.py:155
msgid "Provide a description, attribution, copyright or other information."
msgstr "提供描述、署名、版權或其他資訊。"

#: models.py:164
msgid "External URL"
msgstr "外部 URL"

#: models.py:168
msgid "Wraps the image in a link to an external URL."
msgstr "將圖片包裝為指向外部 URL 的連結。"

#: models.py:171
msgid "Internal URL"
msgstr "內部 URL"

#: models.py:175
msgid "Wraps the image in a link to an internal (page) URL."
msgstr "將圖片包裝為指向內部（頁面）URL 的連結。"

#: models.py:178
msgid "Link target"
msgstr "連結目標"

#: models.py:184
msgid "Link attributes"
msgstr "連結屬性"

#: models.py:195
msgid "Automatic scaling"
msgstr "自動縮放"

#: models.py:198
msgid "Uses the placeholder dimensions to automatically calculate the size."
msgstr "使用預留位置的尺寸自動計算大小。"

#: models.py:203
msgid "Use original image"
msgstr "使用原始圖片"

#: models.py:206
msgid "Outputs the raw image without cropping."
msgstr "輸出未經裁切的原始圖片。"

#: models.py:211
msgid "Crop image"
msgstr "裁切圖片"

#: models.py:214
msgid ""
"Crops the image according to the thumbnail settings provided in the "
"template."
msgstr "依照範本中提供的縮圖設定裁切圖片。"

#: models.py:217
msgid "Upscale image"
msgstr "放大圖片"

#: models.py:220
msgid ""
"Upscales the image to the size of the thumbnail settings in the template."
msgstr "將圖片放大到範本中縮圖設定的大小。"

#: models.py:223
msgid "Use responsive image"
msgstr "使用響應式圖片"

#: models.py:228
msgid ""
"Uses responsive image technique to choose better image to display based upon"
" screen viewport. This configuration only applies to uploaded images "
"(external pictures will not be affected). "
msgstr "使用響應式圖片技術，根據螢幕視窗選擇更合適的圖片。此設定僅適用於上傳的圖片（外部圖片不受影響）。 "

#: models.py:236
msgid "Thumbnail options"
msgstr "縮圖選項"

#: models.py:239
msgid ""
"Overrides width, height, and crop; scales up to the provided preset "
"dimensions."
msgstr "覆寫寬度、高度和裁切設定；最大放大到指定的預設尺寸。"

#: models.py:400
msgid "<file is missing>"
msgstr "<檔案遺失>"

#: models.py:507
msgid ""
"You have given both external and internal links. Only one option is allowed."
msgstr "同時提供了外部連結和內部連結。只能選擇其中一種。"

#: models.py:521
msgid ""
"You need to add either an image, or a URL linking to an external image."
msgstr "必須新增圖片或指向外部圖片的 URL。"

#: models.py:547
#, python-brace-format
msgid ""
"Invalid cropping settings. You cannot combine \"{field_a}\" with "
"\"{field_b}\"."
msgstr "裁切設定無效。不能同時使用「{field_a}」和「{field_b}」。"
