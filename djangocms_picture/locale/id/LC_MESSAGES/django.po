#: apps.py:7
msgid "django CMS Picture"
msgstr "Gambar django CMS"

#: cms_plugins.py:23
msgid "Image"
msgstr "Gambar"

#: cms_plugins.py:33 models.py:158
msgid "Attributes"
msgstr "Atribut"

#: cms_plugins.py:43
msgid "Cropping"
msgstr "Pemotongan"

#: cms_plugins.py:51 models.py:189
msgid "Link"
msgstr "Tautan"

#: fields.py:110
msgid "Select a valid image source."
msgstr "Pilih sumber gambar yang valid."

#: fields.py:111
msgid "Select an image from this source."
msgstr "Pilih gambar dari sumber ini."

#: fields.py:144 forms.py:19 forms.py:53 models.py:97
msgid "Image source"
msgstr "Sumber gambar"

#: models.py:45
msgid "Align left"
msgstr "Rata kiri"

#: models.py:46
msgid "Align right"
msgstr "Rata kanan"

#: models.py:47
msgid "Align center"
msgstr "Rata tengah"

#: models.py:56
msgid "Default"
msgstr "Bawaan"

#: models.py:73
msgid "Open in new window"
msgstr "Buka di jendela baru"

#: models.py:74
msgid "Open in same window"
msgstr "Buka di jendela yang sama"

#: models.py:75
msgid "Delegate to parent"
msgstr "Delegasikan ke induk"

#: models.py:76
msgid "Delegate to top"
msgstr "Delegasikan ke paling atas"

#: models.py:80
msgid "Let settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES decide"
msgstr "Biarkan settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES menentukan"

#: models.py:81
msgid "Yes"
msgstr "Ya"

#: models.py:82
msgid "No"
msgstr "Tidak"

#: models.py:91
msgid "Template"
msgstr "Templat"

#: models.py:103
msgid "Image model"
msgstr "Model gambar"

#: models.py:110
msgid "Image object ID"
msgstr "ID objek gambar"

#: models.py:121
msgid "Image source configuration"
msgstr "Konfigurasi sumber gambar"

#: models.py:127
msgid "Width"
msgstr "Lebar"

#: models.py:131
msgid "The image width as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "Lebar gambar dalam piksel. Contoh: \"720\", bukan \"720px\"."

#: models.py:136
msgid "Height"
msgstr "Tinggi"

#: models.py:140
msgid "The image height as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "Tinggi gambar dalam piksel. Contoh: \"720\", bukan \"720px\"."

#: models.py:145
msgid "Alignment"
msgstr "Perataan"

#: models.py:149
msgid "Aligns the image according to the selected option."
msgstr "Meratakan gambar sesuai opsi yang dipilih."

#: models.py:152
msgid "Caption text"
msgstr "Teks keterangan"

#: models.py:155
msgid "Provide a description, attribution, copyright or other information."
msgstr "Berikan deskripsi, atribusi, hak cipta, atau informasi lainnya."

#: models.py:164
msgid "External URL"
msgstr "URL eksternal"

#: models.py:168
msgid "Wraps the image in a link to an external URL."
msgstr "Membungkus gambar dengan tautan ke URL eksternal."

#: models.py:171
msgid "Internal URL"
msgstr "URL internal"

#: models.py:175
msgid "Wraps the image in a link to an internal (page) URL."
msgstr "Membungkus gambar dengan tautan ke URL internal (halaman)."

#: models.py:178
msgid "Link target"
msgstr "Target tautan"

#: models.py:184
msgid "Link attributes"
msgstr "Atribut tautan"

#: models.py:195
msgid "Automatic scaling"
msgstr "Penskalaan otomatis"

#: models.py:198
msgid "Uses the placeholder dimensions to automatically calculate the size."
msgstr ""
"Menggunakan dimensi placeholder untuk menghitung ukuran secara otomatis."

#: models.py:203
msgid "Use original image"
msgstr "Gunakan gambar asli"

#: models.py:206
msgid "Outputs the raw image without cropping."
msgstr "Menampilkan gambar asli tanpa pemotongan."

#: models.py:211
msgid "Crop image"
msgstr "Potong gambar"

#: models.py:214
msgid ""
"Crops the image according to the thumbnail settings provided in the "
"template."
msgstr ""
"Memotong gambar sesuai pengaturan gambar mini yang diberikan dalam templat."

#: models.py:217
msgid "Upscale image"
msgstr "Perbesar gambar"

#: models.py:220
msgid ""
"Upscales the image to the size of the thumbnail settings in the template."
msgstr ""
"Memperbesar gambar hingga ukuran pengaturan gambar mini dalam templat."

#: models.py:223
msgid "Use responsive image"
msgstr "Gunakan gambar responsif"

#: models.py:228
msgid ""
"Uses responsive image technique to choose better image to display based upon"
" screen viewport. This configuration only applies to uploaded images "
"(external pictures will not be affected). "
msgstr ""
"Menggunakan teknik gambar responsif untuk memilih gambar yang lebih sesuai "
"berdasarkan viewport layar. Konfigurasi ini hanya berlaku untuk gambar yang "
"diunggah (gambar eksternal tidak terpengaruh). "

#: models.py:236
msgid "Thumbnail options"
msgstr "Opsi gambar mini"

#: models.py:239
msgid ""
"Overrides width, height, and crop; scales up to the provided preset "
"dimensions."
msgstr ""
"Menggantikan lebar, tinggi, dan pemotongan; memperbesar hingga dimensi "
"preset yang diberikan."

#: models.py:400
msgid "<file is missing>"
msgstr "<berkas tidak ada>"

#: models.py:507
msgid ""
"You have given both external and internal links. Only one option is allowed."
msgstr ""
"Anda memberikan tautan eksternal dan internal sekaligus. Hanya satu opsi "
"yang diizinkan."

#: models.py:521
msgid ""
"You need to add either an image, or a URL linking to an external image."
msgstr ""
"Anda harus menambahkan gambar atau URL yang mengarah ke gambar eksternal."

#: models.py:547
#, python-brace-format
msgid ""
"Invalid cropping settings. You cannot combine \"{field_a}\" with "
"\"{field_b}\"."
msgstr ""
"Pengaturan pemotongan tidak valid. Anda tidak dapat menggabungkan "
"\"{field_a}\" dengan \"{field_b}\"."
