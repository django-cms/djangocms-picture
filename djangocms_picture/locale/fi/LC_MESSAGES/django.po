#: apps.py:7
msgid "django CMS Picture"
msgstr "django CMS -kuva"

#: cms_plugins.py:23
msgid "Image"
msgstr "Kuva"

#: cms_plugins.py:33 models.py:158
msgid "Attributes"
msgstr "Määritteet"

#: cms_plugins.py:43
msgid "Cropping"
msgstr "Rajaus"

#: cms_plugins.py:51 models.py:189
msgid "Link"
msgstr "Linkki"

#: fields.py:110
msgid "Select a valid image source."
msgstr "Valitse kelvollinen kuvalähde."

#: fields.py:111
msgid "Select an image from this source."
msgstr "Valitse kuva tästä lähteestä."

#: fields.py:144 forms.py:19 forms.py:53 models.py:97
msgid "Image source"
msgstr "Kuvalähde"

#: models.py:45
msgid "Align left"
msgstr "Tasaa vasemmalle"

#: models.py:46
msgid "Align right"
msgstr "Tasaa oikealle"

#: models.py:47
msgid "Align center"
msgstr "Tasaa keskelle"

#: models.py:56
msgid "Default"
msgstr "Oletus"

#: models.py:73
msgid "Open in new window"
msgstr "Avaa uudessa ikkunassa"

#: models.py:74
msgid "Open in same window"
msgstr "Avaa samassa ikkunassa"

#: models.py:75
msgid "Delegate to parent"
msgstr "Siirrä pääikkunalle"

#: models.py:76
msgid "Delegate to top"
msgstr "Siirrä ylimmälle ikkunalle"

#: models.py:80
msgid "Let settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES decide"
msgstr "Anna settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES-asetuksen päättää"

#: models.py:81
msgid "Yes"
msgstr "Kyllä"

#: models.py:82
msgid "No"
msgstr "Ei"

#: models.py:91
msgid "Template"
msgstr "Mallipohja"

#: models.py:103
msgid "Image model"
msgstr "Kuvamalli"

#: models.py:110
msgid "Image object ID"
msgstr "Kuvaobjektin tunnus"

#: models.py:121
msgid "Image source configuration"
msgstr "Kuvalähteen määritys"

#: models.py:127
msgid "Width"
msgstr "Leveys"

#: models.py:131
msgid "The image width as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "Kuvan leveys pikseleinä. Esimerkki: \"720\", ei \"720px\"."

#: models.py:136
msgid "Height"
msgstr "Korkeus"

#: models.py:140
msgid "The image height as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "Kuvan korkeus pikseleinä. Esimerkki: \"720\", ei \"720px\"."

#: models.py:145
msgid "Alignment"
msgstr "Tasaus"

#: models.py:149
msgid "Aligns the image according to the selected option."
msgstr "Tasaa kuvan valitun vaihtoehdon mukaan."

#: models.py:152
msgid "Caption text"
msgstr "Kuvateksti"

#: models.py:155
msgid "Provide a description, attribution, copyright or other information."
msgstr "Anna kuvaus, tekijätieto, tekijänoikeus tai muu tieto."

#: models.py:164
msgid "External URL"
msgstr "Ulkoinen URL-osoite"

#: models.py:168
msgid "Wraps the image in a link to an external URL."
msgstr "Ympäröi kuvan linkillä ulkoiseen URL-osoitteeseen."

#: models.py:171
msgid "Internal URL"
msgstr "Sisäinen URL-osoite"

#: models.py:175
msgid "Wraps the image in a link to an internal (page) URL."
msgstr "Ympäröi kuvan linkillä sisäiseen (sivun) URL-osoitteeseen."

#: models.py:178
msgid "Link target"
msgstr "Linkin kohde"

#: models.py:184
msgid "Link attributes"
msgstr "Linkin määritteet"

#: models.py:195
msgid "Automatic scaling"
msgstr "Automaattinen skaalaus"

#: models.py:198
msgid "Uses the placeholder dimensions to automatically calculate the size."
msgstr "Laskee koon automaattisesti paikkamerkin mittojen perusteella."

#: models.py:203
msgid "Use original image"
msgstr "Käytä alkuperäistä kuvaa"

#: models.py:206
msgid "Outputs the raw image without cropping."
msgstr "Tulostaa alkuperäisen kuvan rajaamatta."

#: models.py:211
msgid "Crop image"
msgstr "Rajaa kuva"

#: models.py:214
msgid ""
"Crops the image according to the thumbnail settings provided in the "
"template."
msgstr "Rajaa kuvan mallipohjassa annettujen pienoiskuva-asetusten mukaan."

#: models.py:217
msgid "Upscale image"
msgstr "Suurenna kuvaa"

#: models.py:220
msgid ""
"Upscales the image to the size of the thumbnail settings in the template."
msgstr "Suurentaa kuvan mallipohjan pienoiskuva-asetusten kokoon."

#: models.py:223
msgid "Use responsive image"
msgstr "Käytä responsiivista kuvaa"

#: models.py:228
msgid ""
"Uses responsive image technique to choose better image to display based upon"
" screen viewport. This configuration only applies to uploaded images "
"(external pictures will not be affected). "
msgstr ""
"Valitsee responsiivisella kuvatekniikalla näyttöön sopivamman kuvan näkymän "
"koon perusteella. Asetus koskee vain ladattuja kuvia (ei ulkoisia kuvia). "

#: models.py:236
msgid "Thumbnail options"
msgstr "Pienoiskuvan asetukset"

#: models.py:239
msgid ""
"Overrides width, height, and crop; scales up to the provided preset "
"dimensions."
msgstr ""
"Ohittaa leveyden, korkeuden ja rajauksen sekä suurentaa annettuihin "
"esiasetusmittoihin asti."

#: models.py:400
msgid "<file is missing>"
msgstr "<tiedosto puuttuu>"

#: models.py:507
msgid ""
"You have given both external and internal links. Only one option is allowed."
msgstr ""
"Olet antanut sekä ulkoisen että sisäisen linkin. Vain yksi vaihtoehto "
"sallitaan."

#: models.py:521
msgid ""
"You need to add either an image, or a URL linking to an external image."
msgstr "Lisää joko kuva tai ulkoiseen kuvaan viittaava URL-osoite."

#: models.py:547
#, python-brace-format
msgid ""
"Invalid cropping settings. You cannot combine \"{field_a}\" with "
"\"{field_b}\"."
msgstr ""
"Virheelliset rajausasetukset. Et voi yhdistää kenttiä \"{field_a}\" ja "
"\"{field_b}\"."
