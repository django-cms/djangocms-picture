#: apps.py:7
msgid "django CMS Picture"
msgstr "django CMS-afbeelding"

#: cms_plugins.py:23
msgid "Image"
msgstr "Afbeelding"

#: cms_plugins.py:33 models.py:158
msgid "Attributes"
msgstr "Attributen"

#: cms_plugins.py:43
#| msgid "Crop image"
msgid "Cropping"
msgstr "Bijsnijden"

#: cms_plugins.py:51 models.py:189
msgid "Link"
msgstr "Link"

#: fields.py:110
msgid "Select a valid image source."
msgstr "Selecteer een geldige afbeeldingsbron."

#: fields.py:111
msgid "Select an image from this source."
msgstr "Selecteer een afbeelding uit deze bron."

#: fields.py:144 forms.py:19 forms.py:53 models.py:97
msgid "Image source"
msgstr "Afbeeldingsbron"

#: models.py:45
msgid "Align left"
msgstr "Links uitlijnen"

#: models.py:46
msgid "Align right"
msgstr "Rechts uitlijnen"

#: models.py:47
msgid "Align center"
msgstr "Centreren"

#: models.py:56
msgid "Default"
msgstr "Standaard"

#: models.py:73
msgid "Open in new window"
msgstr "Open in nieuw venster"

#: models.py:74
msgid "Open in same window"
msgstr "Open in huidig venster"

#: models.py:75
msgid "Delegate to parent"
msgstr "Delegeren aan bovenliggend venster"

#: models.py:76
msgid "Delegate to top"
msgstr "Delegeren aan hoogste venster"

#: models.py:80
msgid "Let settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES decide"
msgstr "Laat settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES beslissen"

#: models.py:81
msgid "Yes"
msgstr "Ja"

#: models.py:82
msgid "No"
msgstr "Nee"

#: models.py:91
msgid "Template"
msgstr "Sjabloon"

#: models.py:103
#| msgid "Image"
msgid "Image model"
msgstr "Afbeeldingsmodel"

#: models.py:110
msgid "Image object ID"
msgstr "Afbeeldingsobject-ID"

#: models.py:121
msgid "Image source configuration"
msgstr "Configuratie van afbeeldingsbron"

#: models.py:127
msgid "Width"
msgstr "Breedte"

#: models.py:131
msgid "The image width as number in pixels. Example: \"720\" and not \"720px\"."
msgstr ""
"De breedte van de afbeelding in pixels. Bijvoorbeeld: \"720\" en niet "
"\"720px\"."

#: models.py:136
msgid "Height"
msgstr "Hoogte"

#: models.py:140
msgid "The image height as number in pixels. Example: \"720\" and not \"720px\"."
msgstr ""
"De hoogte van de afbeelding in pixels. Bijvoorbeeld: \"720\" en niet "
"\"720px\"."

#: models.py:145
msgid "Alignment"
msgstr "Uitlijning"

#: models.py:149
msgid "Aligns the image according to the selected option."
msgstr "Lijnt de afbeelding uit afhankelijk van de geselecteerde optie."

#: models.py:152
msgid "Caption text"
msgstr "Onderschrift"

#: models.py:155
msgid "Provide a description, attribution, copyright or other information."
msgstr ""
"Voeg een beschrijving, auteursrechtinformatie, bronvermelding of andere "
"informatie toe."

#: models.py:164
msgid "External URL"
msgstr "Externe URL"

#: models.py:168
msgid "Wraps the image in a link to an external URL."
msgstr "Laat de afbeelding linken naar een externe URL."

#: models.py:171
msgid "Internal URL"
msgstr "Interne URL"

#: models.py:175
msgid "Wraps the image in a link to an internal (page) URL."
msgstr "Laat de afbeelding linken naar een interne URL."

#: models.py:178
msgid "Link target"
msgstr "Venster"

#: models.py:184
msgid "Link attributes"
msgstr "Linkattributen"

#: models.py:195
msgid "Automatic scaling"
msgstr "Automatisch schalen"

#: models.py:198
msgid "Uses the placeholder dimensions to automatically calculate the size."
msgstr ""
"Gebruikt de afmetingen van de placeholder om de grootte automatisch te "
"berekenen."

#: models.py:203
msgid "Use original image"
msgstr "Gebruik originele afbeelding"

#: models.py:206
msgid "Outputs the raw image without cropping."
msgstr "Gebruik de originele afbeelding zonder deze bij te snijden."

#: models.py:211
msgid "Crop image"
msgstr "Snij afbeelding bij"

#: models.py:214
msgid ""
"Crops the image according to the thumbnail settings provided in the "
"template."
msgstr ""
"Snij de afbeelding bij aan de hand van de thumbnail-instellingen in het "
"sjabloon."

#: models.py:217
msgid "Upscale image"
msgstr "Schaal afbeelding op"

#: models.py:220
msgid ""
"Upscales the image to the size of the thumbnail settings in the template."
msgstr ""
"Schaal de afdbeelding op aan de hand van thumbnail-instellingen in het "
"sjabloon."

#: models.py:223
msgid "Use responsive image"
msgstr "Responsieve afbeelding gebruiken"

#: models.py:228
msgid ""
"Uses responsive image technique to choose better image to display based upon"
" screen viewport. This configuration only applies to uploaded images "
"(external pictures will not be affected). "
msgstr ""
"Gebruikt responsieve afbeeldingstechniek om op basis van de schermviewport "
"een betere afbeelding te kiezen. Deze configuratie geldt alleen voor "
"geüploade afbeeldingen (externe afbeeldingen worden niet beïnvloed). "

#: models.py:236
msgid "Thumbnail options"
msgstr "Thumbnail-opties"

#: models.py:239
msgid ""
"Overrides width, height, and crop; scales up to the provided preset "
"dimensions."
msgstr ""
"Overschrijf breedte, hoogte en bijsnijden; Schaalt op tot de vooraf-"
"opgegeven afmetingen."

#: models.py:400
msgid "<file is missing>"
msgstr "<bestand ontbreekt>"

#: models.py:507
msgid ""
"You have given both external and internal links. Only one option is allowed."
msgstr ""
"U heeft zowel een interne als een externe link opgegeven. U kunt echter "
"slechts één van beide gebruiken."

#: models.py:521
msgid ""
"You need to add either an image, or a URL linking to an external image."
msgstr ""
"U moet een afbeelding óf een URL naar een externe afbeelding toevoegen."

#: models.py:547
#, python-brace-format
msgid ""
"Invalid cropping settings. You cannot combine \"{field_a}\" with "
"\"{field_b}\"."
msgstr ""
"Ongeldige instellingen voor bijsnijden. \"{field_a}\" en \"{field_b}\" "
"kunnen niet samen worden gebruikt."
