#: apps.py:7
msgid "django CMS Picture"
msgstr "Image django CMS"

#: cms_plugins.py:23
msgid "Image"
msgstr "Image"

#: cms_plugins.py:33 models.py:158
msgid "Attributes"
msgstr "Propriétés"

#: cms_plugins.py:43
#| msgid "Crop image"
msgid "Cropping"
msgstr "Recadrage"

#: cms_plugins.py:51 models.py:189
msgid "Link"
msgstr "Lien"

#: fields.py:110
msgid "Select a valid image source."
msgstr "Sélectionnez une source d’images valide."

#: fields.py:111
msgid "Select an image from this source."
msgstr "Sélectionnez une image dans cette source."

#: fields.py:144 forms.py:19 forms.py:53 models.py:97
msgid "Image source"
msgstr "Source d’images"

#: models.py:45
msgid "Align left"
msgstr "Aligner à gauche"

#: models.py:46
msgid "Align right"
msgstr "Aligner à droite"

#: models.py:47
msgid "Align center"
msgstr "Centrer"

#: models.py:56
msgid "Default"
msgstr "Défaut"

#: models.py:73
msgid "Open in new window"
msgstr "Ouvrir dans une nouvelle fenêtre"

#: models.py:74
msgid "Open in same window"
msgstr "Ouvrir dans la fenêtre actuelle"

#: models.py:75
msgid "Delegate to parent"
msgstr "Déléguer au parent"

#: models.py:76
msgid "Delegate to top"
msgstr "Déléguer à la fenêtre principale"

#: models.py:80
msgid "Let settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES decide"
msgstr "Laisser settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES décider"

#: models.py:81
msgid "Yes"
msgstr "Oui"

#: models.py:82
msgid "No"
msgstr "Non"

#: models.py:91
msgid "Template"
msgstr "Modèle"

#: models.py:103
#| msgid "Image"
msgid "Image model"
msgstr "Modèle d’image"

#: models.py:110
msgid "Image object ID"
msgstr "ID de l’objet image"

#: models.py:121
msgid "Image source configuration"
msgstr "Configuration de la source d’images"

#: models.py:127
msgid "Width"
msgstr "Largeur"

#: models.py:131
msgid "The image width as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "La largeur de l'image en nombre de pixels. Exemple: \"720\" et non \"720px\"."

#: models.py:136
msgid "Height"
msgstr "Hauteur"

#: models.py:140
msgid "The image height as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "La hauteur de l'image en nombre de pixels. Exemple: \"720\" et non \"720px\"."

#: models.py:145
msgid "Alignment"
msgstr "Alignement"

#: models.py:149
msgid "Aligns the image according to the selected option."
msgstr "Aligner l'image selon l'option sélectionnée."

#: models.py:152
msgid "Caption text"
msgstr "Légende"

#: models.py:155
msgid "Provide a description, attribution, copyright or other information."
msgstr ""
"Attribuez une description, une attribution, un copyright ou autre "
"information"

#: models.py:164
msgid "External URL"
msgstr "URL externe"

#: models.py:168
msgid "Wraps the image in a link to an external URL."
msgstr "Enveloppe l'image dans un lien vers une URL externe."

#: models.py:171
msgid "Internal URL"
msgstr "URL interne"

#: models.py:175
msgid "Wraps the image in a link to an internal (page) URL."
msgstr "Enveloppe l'image dans un lien vers une URL interne (page)."

#: models.py:178
msgid "Link target"
msgstr "Objectif du lien"

#: models.py:184
msgid "Link attributes"
msgstr "Propriétés du lien"

#: models.py:195
msgid "Automatic scaling"
msgstr "Mise à l'échelle automatique"

#: models.py:198
msgid "Uses the placeholder dimensions to automatically calculate the size."
msgstr ""
"Utilise les dimensions de l'espace réservé pour calculer automatiquement la "
"taille."

#: models.py:203
msgid "Use original image"
msgstr "Utilisez l'image originale"

#: models.py:206
msgid "Outputs the raw image without cropping."
msgstr "Sort l'image brute sans recadrage."

#: models.py:211
msgid "Crop image"
msgstr "Rogner l'image"

#: models.py:214
msgid ""
"Crops the image according to the thumbnail settings provided in the "
"template."
msgstr ""
"Rogner l'image selon les paramètres de la miniature attribués dans le "
"modèle."

#: models.py:217
msgid "Upscale image"
msgstr "Améliorer l'image"

#: models.py:220
msgid ""
"Upscales the image to the size of the thumbnail settings in the template."
msgstr ""
"Améliore l'image de la taille des paramètres de la vignette dans le modèle."

#: models.py:223
msgid "Use responsive image"
msgstr "Utiliser l'image responsive"

#: models.py:228
msgid ""
"Uses responsive image technique to choose better image to display based upon"
" screen viewport. This configuration only applies to uploaded images "
"(external pictures will not be affected). "
msgstr ""
"Utilise la technique d’image responsive pour choisir la meilleure image à "
"afficher en fonction de la fenêtre d’affichage. Cette configuration ne "
"s'applique qu'aux images téléchargées (les images externes ne seront pas "
"affectées)."

#: models.py:236
msgid "Thumbnail options"
msgstr "Paramètres de la miniature"

#: models.py:239
msgid ""
"Overrides width, height, and crop; scales up to the provided preset "
"dimensions."
msgstr ""
"Remplace la largeur, la hauteur et le recadrage; échelles jusqu'aux "
"dimensions prédéfinies fournies."

#: models.py:400
msgid "<file is missing>"
msgstr "<fichier manquant>"

#: models.py:507
msgid ""
"You have given both external and internal links. Only one option is allowed."
msgstr ""
"Vous avez introduit des liens internes et externes. Seule une option est "
"autorisée."

#: models.py:521
msgid ""
"You need to add either an image, or a URL linking to an external image."
msgstr ""
"Vous devez ajouter une image ou une URL renvoyant à une image externe."

#: models.py:547
#, python-brace-format
msgid ""
"Invalid cropping settings. You cannot combine \"{field_a}\" with "
"\"{field_b}\"."
msgstr ""
"Paramètres de recadrage non valides. Vous ne pouvez pas combiner "
"\"{field_a}\" avec \"{field_b}\"."
