#: apps.py:7
msgid "django CMS Picture"
msgstr "django CMS vaizdas"

#: cms_plugins.py:23
msgid "Image"
msgstr "Paveiksliukas"

#: cms_plugins.py:33 models.py:158
msgid "Attributes"
msgstr "Atributai"

#: cms_plugins.py:43
#| msgid "Crop image"
msgid "Cropping"
msgstr "Apkarpymas"

#: cms_plugins.py:51 models.py:189
msgid "Link"
msgstr "Nuoroda"

#: fields.py:110
msgid "Select a valid image source."
msgstr "Pasirinkite tinkamą vaizdų šaltinį."

#: fields.py:111
msgid "Select an image from this source."
msgstr "Pasirinkite vaizdą iš šio šaltinio."

#: fields.py:144 forms.py:19 forms.py:53 models.py:97
msgid "Image source"
msgstr "Vaizdo šaltinis"

#: models.py:45
msgid "Align left"
msgstr "Lygiuoti į kairę"

#: models.py:46
msgid "Align right"
msgstr "Lygiuoti į dešinę"

#: models.py:47
msgid "Align center"
msgstr "Lygiuoti į centrą"

#: models.py:56
msgid "Default"
msgstr "Numatytasis"

#: models.py:73
msgid "Open in new window"
msgstr "Atidaryti naujame lange"

#: models.py:74
msgid "Open in same window"
msgstr "Atidaryti tame pačiame lange"

#: models.py:75
msgid "Delegate to parent"
msgstr "Nukreipti į tėvinį elementą"

#: models.py:76
msgid "Delegate to top"
msgstr "Nukreipti į viršų"

#: models.py:80
msgid "Let settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES decide"
msgstr "Leisti nuspręsti settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES"

#: models.py:81
msgid "Yes"
msgstr "Taip"

#: models.py:82
msgid "No"
msgstr "Ne"

#: models.py:91
msgid "Template"
msgstr "Šablonas"

#: models.py:103
#| msgid "Image"
msgid "Image model"
msgstr "Vaizdo modelis"

#: models.py:110
msgid "Image object ID"
msgstr "Vaizdo objekto ID"

#: models.py:121
msgid "Image source configuration"
msgstr "Vaizdo šaltinio konfigūracija"

#: models.py:127
msgid "Width"
msgstr "Plotis"

#: models.py:131
msgid "The image width as number in pixels. Example: \"720\" and not \"720px\"."
msgstr ""
"Paveikslėlio plotis pikseliais kaip numeris. Pavyzdžiui: \"720\" o ne "
"\"720px\"."

#: models.py:136
msgid "Height"
msgstr "Aukštis"

#: models.py:140
msgid "The image height as number in pixels. Example: \"720\" and not \"720px\"."
msgstr ""
"Paveikslėlio aukštis pikseliais kaip numeris. Pavyzdžiui: \"720\" o ne "
"\"720px\"."

#: models.py:145
msgid "Alignment"
msgstr "Lygiavimas"

#: models.py:149
msgid "Aligns the image according to the selected option."
msgstr "Lygiuoją paveikslėlį pagal pasirinktą nustatymą."

#: models.py:152
msgid "Caption text"
msgstr "Antraštės tekstas"

#: models.py:155
msgid "Provide a description, attribution, copyright or other information."
msgstr "Įrašykite apibūdinimą, teisės turėtojo ar kitą informaciją."

#: models.py:164
msgid "External URL"
msgstr "Išorinis URL"

#: models.py:168
msgid "Wraps the image in a link to an external URL."
msgstr "Apgaubia paveikslėlį nuoroda į išorinį URL."

#: models.py:171
msgid "Internal URL"
msgstr "Vidinis URL"

#: models.py:175
msgid "Wraps the image in a link to an internal (page) URL."
msgstr "Apgaubia paveikslėlį nuoroda į vidinį (puslapį) URL."

#: models.py:178
msgid "Link target"
msgstr "Nuorodos langas"

#: models.py:184
msgid "Link attributes"
msgstr "Nuorodos atributai"

#: models.py:195
msgid "Automatic scaling"
msgstr "Automatinis mastelis"

#: models.py:198
msgid "Uses the placeholder dimensions to automatically calculate the size."
msgstr ""
"Naudoja vietos rezervavimo ženklo matmenis dydžiui automatiškai "
"apskaičiuoti."

#: models.py:203
msgid "Use original image"
msgstr "Naudoti originalų paveikslėlį"

#: models.py:206
msgid "Outputs the raw image without cropping."
msgstr "Atvaizduoją gryną paveikslėlį, be apkirpimo."

#: models.py:211
msgid "Crop image"
msgstr "Apkirpti paveikslėlį"

#: models.py:214
msgid ""
"Crops the image according to the thumbnail settings provided in the "
"template."
msgstr "Apkerpa paveikslėli pagal miniatiūros nustatymus suvestus šablone."

#: models.py:217
msgid "Upscale image"
msgstr "Išdidinti paveikslėlį"

#: models.py:220
msgid ""
"Upscales the image to the size of the thumbnail settings in the template."
msgstr ""
"Išdidina paveikslėli tokiu dydžiu koks nurodytas miniatiūros nustatymuose "
"suvestuose šablone."

#: models.py:223
msgid "Use responsive image"
msgstr "Naudoti adaptyvų vaizdą"

#: models.py:228
msgid ""
"Uses responsive image technique to choose better image to display based upon"
" screen viewport. This configuration only applies to uploaded images "
"(external pictures will not be affected). "
msgstr ""
"Naudoja adaptyvių vaizdų technologiją tinkamesniam vaizdui parinkti pagal "
"ekrano peržiūros sritį. Ši konfigūracija taikoma tik įkeltiems vaizdams "
"(išoriniams vaizdams ji neturi įtakos). "

#: models.py:236
msgid "Thumbnail options"
msgstr "Miniatiūros nustatymai"

#: models.py:239
msgid ""
"Overrides width, height, and crop; scales up to the provided preset "
"dimensions."
msgstr ""
"Perrašo plotį, aukštį ir apkerpa, išdidina pagal pateiktus išmatavimus."

#: models.py:400
msgid "<file is missing>"
msgstr "<byla nerasta>"

#: models.py:507
msgid ""
"You have given both external and internal links. Only one option is allowed."
msgstr ""
"Jūs pateikėte ir išorinę ir vidinę nuorodas. Galimas tik vienas "
"pasirinkimas."

#: models.py:521
msgid ""
"You need to add either an image, or a URL linking to an external image."
msgstr "Turite pridėti arba paveikslėli, arba nuorodą į išorinį paveikslėlį."

#: models.py:547
#, python-brace-format
msgid ""
"Invalid cropping settings. You cannot combine \"{field_a}\" with "
"\"{field_b}\"."
msgstr ""
"Netinkami apkirpimo nustatymai. Negalite sujungti \"{field_a}\" su "
"\"{field_b}\"."
