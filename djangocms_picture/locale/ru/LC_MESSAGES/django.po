#: apps.py:7
msgid "django CMS Picture"
msgstr "Изображение django CMS"

#: cms_plugins.py:23
msgid "Image"
msgstr "Изображение"

#: cms_plugins.py:33 models.py:158
msgid "Attributes"
msgstr "Атрибуты"

#: cms_plugins.py:43
#| msgid "Crop image"
msgid "Cropping"
msgstr "Кадрирование"

#: cms_plugins.py:51 models.py:189
msgid "Link"
msgstr "Ссылка"

#: fields.py:110
msgid "Select a valid image source."
msgstr "Выберите допустимый источник изображений."

#: fields.py:111
msgid "Select an image from this source."
msgstr "Выберите изображение из этого источника."

#: fields.py:144 forms.py:19 forms.py:53 models.py:97
msgid "Image source"
msgstr "Источник изображения"

#: models.py:45
msgid "Align left"
msgstr "Выравнивать влево"

#: models.py:46
msgid "Align right"
msgstr "Выравнивать вправо"

#: models.py:47
msgid "Align center"
msgstr "Выравнивать по центру"

#: models.py:56
msgid "Default"
msgstr "По умолчанию"

#: models.py:73
msgid "Open in new window"
msgstr "Открыть в новом окне"

#: models.py:74
msgid "Open in same window"
msgstr "Открыть в том же окне"

#: models.py:75
msgid "Delegate to parent"
msgstr "Передать в родительский фрейм"

#: models.py:76
msgid "Delegate to top"
msgstr "Передать в фрейм верхнего уровня"

#: models.py:80
msgid "Let settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES decide"
msgstr "Определяется настройкой settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES"

#: models.py:81
msgid "Yes"
msgstr "Да"

#: models.py:82
msgid "No"
msgstr "Нет"

#: models.py:91
msgid "Template"
msgstr "Шаблон"

#: models.py:103
#| msgid "Image"
msgid "Image model"
msgstr "Модель изображения"

#: models.py:110
msgid "Image object ID"
msgstr "ID объекта изображения"

#: models.py:121
msgid "Image source configuration"
msgstr "Конфигурация источника изображения"

#: models.py:127
msgid "Width"
msgstr "Ширина"

#: models.py:131
msgid "The image width as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "Ширина изображения в пикселях. Например: \"720\", но не \"720px\""

#: models.py:136
msgid "Height"
msgstr "Высота"

#: models.py:140
msgid "The image height as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "Высота изображения в пикселях. Например: \"720\", но не \"720px\""

#: models.py:145
msgid "Alignment"
msgstr "Выравнивание"

#: models.py:149
msgid "Aligns the image according to the selected option."
msgstr "Выравнивать изображение в соответствии с выбранной опцией."

#: models.py:152
msgid "Caption text"
msgstr "Текст заголовка"

#: models.py:155
msgid "Provide a description, attribution, copyright or other information."
msgstr "Добавьте описание, атрибуты, копирайты и т.д."

#: models.py:164
msgid "External URL"
msgstr "Внешний URL"

#: models.py:168
msgid "Wraps the image in a link to an external URL."
msgstr "\"Обернуть\" изображение ссылкой на внешний URL."

#: models.py:171
msgid "Internal URL"
msgstr "Внутренний URL"

#: models.py:175
msgid "Wraps the image in a link to an internal (page) URL."
msgstr "\"Обернуть\" изображение ссылкой на внутренний URL (страницу)."

#: models.py:178
msgid "Link target"
msgstr "Цель ссылки"

#: models.py:184
msgid "Link attributes"
msgstr "Атрибуты ссылки"

#: models.py:195
msgid "Automatic scaling"
msgstr "Автоматическое масштабирование"

#: models.py:198
msgid "Uses the placeholder dimensions to automatically calculate the size."
msgstr ""
"Использует размеры заполнителя для автоматического вычисления размера."

#: models.py:203
msgid "Use original image"
msgstr "Использовать оригинальное изображение."

#: models.py:206
msgid "Outputs the raw image without cropping."
msgstr "Выводит \"сырое\" изображение без обрезки."

#: models.py:211
msgid "Crop image"
msgstr "Обрезать изображение"

#: models.py:214
msgid ""
"Crops the image according to the thumbnail settings provided in the "
"template."
msgstr ""
"Обрезать изображение в соответствии с настройками миниатюры, указанными в "
"шаблоне."

#: models.py:217
msgid "Upscale image"
msgstr "Увеличивать изображение"

#: models.py:220
msgid ""
"Upscales the image to the size of the thumbnail settings in the template."
msgstr ""
"Растягивает изображение до размеров, указанных в настройках миниатюры в "
"шаблоне."

#: models.py:223
msgid "Use responsive image"
msgstr "Использовать адаптивное изображение"

#: models.py:228
msgid ""
"Uses responsive image technique to choose better image to display based upon"
" screen viewport. This configuration only applies to uploaded images "
"(external pictures will not be affected). "
msgstr ""
"Использует технологию адаптивных изображений для выбора подходящего "
"изображения с учетом области просмотра. Настройка применяется только к "
"загруженным изображениям (внешние изображения не изменяются). "

#: models.py:236
msgid "Thumbnail options"
msgstr "Опции миниатюры"

#: models.py:239
msgid ""
"Overrides width, height, and crop; scales up to the provided preset "
"dimensions."
msgstr ""
"Замещает ширину, высоты и обрезку; масштабирует до указанных "
"предустановленных размерностей."

#: models.py:400
msgid "<file is missing>"
msgstr "<файл отсутствует>"

#: models.py:507
msgid ""
"You have given both external and internal links. Only one option is allowed."
msgstr ""
"Вы указали как внешнюю, так и внутреннюю ссылки. Разрешается только одна."

#: models.py:521
msgid ""
"You need to add either an image, or a URL linking to an external image."
msgstr ""
"Нужно либо добавить изображение, либо задать URL, указывающий на внешнее "
"изображение."

#: models.py:547
#, python-brace-format
msgid ""
"Invalid cropping settings. You cannot combine \"{field_a}\" with "
"\"{field_b}\"."
msgstr ""
"Некорректные настройки обрезки. Вы не можете сочетать \"{field_a}\" с "
"\"{field_b}\"."
