#: apps.py:7
msgid "django CMS Picture"
msgstr "صور django CMS"

#: cms_plugins.py:23
msgid "Image"
msgstr "صورة"

#: cms_plugins.py:33 models.py:158
msgid "Attributes"
msgstr "السمات"

#: cms_plugins.py:43
msgid "Cropping"
msgstr "الاقتصاص"

#: cms_plugins.py:51 models.py:189
msgid "Link"
msgstr "الرابط"

#: fields.py:110
msgid "Select a valid image source."
msgstr "حدد مصدر صور صالحًا."

#: fields.py:111
msgid "Select an image from this source."
msgstr "حدد صورة من هذا المصدر."

#: fields.py:144 forms.py:19 forms.py:53 models.py:97
msgid "Image source"
msgstr "مصدر الصورة"

#: models.py:45
msgid "Align left"
msgstr "محاذاة لليسار"

#: models.py:46
msgid "Align right"
msgstr "محاذاة لليمين"

#: models.py:47
msgid "Align center"
msgstr "محاذاة للوسط"

#: models.py:56
msgid "Default"
msgstr "افتراضي"

#: models.py:73
msgid "Open in new window"
msgstr "فتح في نافذة جديدة"

#: models.py:74
msgid "Open in same window"
msgstr "فتح في النافذة نفسها"

#: models.py:75
msgid "Delegate to parent"
msgstr "إسناد إلى الأصل"

#: models.py:76
msgid "Delegate to top"
msgstr "إسناد إلى الأعلى"

#: models.py:80
msgid "Let settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES decide"
msgstr "دع settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES يقرر"

#: models.py:81
msgid "Yes"
msgstr "نعم"

#: models.py:82
msgid "No"
msgstr "لا"

#: models.py:91
msgid "Template"
msgstr "القالب"

#: models.py:103
msgid "Image model"
msgstr "نموذج الصورة"

#: models.py:110
msgid "Image object ID"
msgstr "معرّف كائن الصورة"

#: models.py:121
msgid "Image source configuration"
msgstr "إعدادات مصدر الصورة"

#: models.py:127
msgid "Width"
msgstr "العرض"

#: models.py:131
msgid "The image width as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "عرض الصورة كعدد بالبكسل. مثال: \"720\" وليس \"720px\"."

#: models.py:136
msgid "Height"
msgstr "الارتفاع"

#: models.py:140
msgid "The image height as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "ارتفاع الصورة كعدد بالبكسل. مثال: \"720\" وليس \"720px\"."

#: models.py:145
msgid "Alignment"
msgstr "المحاذاة"

#: models.py:149
msgid "Aligns the image according to the selected option."
msgstr "يحاذي الصورة وفقًا للخيار المحدد."

#: models.py:152
msgid "Caption text"
msgstr "نص التسمية"

#: models.py:155
msgid "Provide a description, attribution, copyright or other information."
msgstr "قدّم وصفًا أو إسنادًا أو حقوق نشر أو معلومات أخرى."

#: models.py:164
msgid "External URL"
msgstr "عنوان URL خارجي"

#: models.py:168
msgid "Wraps the image in a link to an external URL."
msgstr "يلف الصورة برابط إلى عنوان URL خارجي."

#: models.py:171
msgid "Internal URL"
msgstr "عنوان URL داخلي"

#: models.py:175
msgid "Wraps the image in a link to an internal (page) URL."
msgstr "يلف الصورة برابط إلى عنوان URL داخلي (صفحة)."

#: models.py:178
msgid "Link target"
msgstr "هدف الرابط"

#: models.py:184
msgid "Link attributes"
msgstr "سمات الرابط"

#: models.py:195
msgid "Automatic scaling"
msgstr "التحجيم التلقائي"

#: models.py:198
msgid "Uses the placeholder dimensions to automatically calculate the size."
msgstr "يستخدم أبعاد العنصر النائب لحساب الحجم تلقائيًا."

#: models.py:203
msgid "Use original image"
msgstr "استخدام الصورة الأصلية"

#: models.py:206
msgid "Outputs the raw image without cropping."
msgstr "يعرض الصورة الخام دون اقتصاص."

#: models.py:211
msgid "Crop image"
msgstr "اقتصاص الصورة"

#: models.py:214
msgid ""
"Crops the image according to the thumbnail settings provided in the "
"template."
msgstr "يقتص الصورة وفقًا لإعدادات الصورة المصغرة المحددة في القالب."

#: models.py:217
msgid "Upscale image"
msgstr "تكبير الصورة"

#: models.py:220
msgid ""
"Upscales the image to the size of the thumbnail settings in the template."
msgstr "يكبّر الصورة إلى حجم إعدادات الصورة المصغرة في القالب."

#: models.py:223
msgid "Use responsive image"
msgstr "استخدام صورة متجاوبة"

#: models.py:228
msgid ""
"Uses responsive image technique to choose better image to display based upon"
" screen viewport. This configuration only applies to uploaded images "
"(external pictures will not be affected). "
msgstr ""
"يستخدم تقنية الصور المتجاوبة لاختيار صورة أفضل للعرض استنادًا إلى إطار عرض "
"الشاشة. ينطبق هذا الإعداد على الصور المرفوعة فقط (لن تتأثر الصور الخارجية). "

#: models.py:236
msgid "Thumbnail options"
msgstr "خيارات الصورة المصغرة"

#: models.py:239
msgid ""
"Overrides width, height, and crop; scales up to the provided preset "
"dimensions."
msgstr ""
"يتجاوز العرض والارتفاع والاقتصاص؛ ويكبّر حتى أبعاد الإعداد المسبق المحددة."

#: models.py:400
msgid "<file is missing>"
msgstr "<الملف مفقود>"

#: models.py:507
msgid ""
"You have given both external and internal links. Only one option is allowed."
msgstr "لقد أدخلت رابطًا خارجيًا ورابطًا داخليًا معًا. يُسمح بخيار واحد فقط."

#: models.py:521
msgid ""
"You need to add either an image, or a URL linking to an external image."
msgstr "تحتاج إلى إضافة صورة أو عنوان URL يشير إلى صورة خارجية."

#: models.py:547
#, python-brace-format
msgid ""
"Invalid cropping settings. You cannot combine \"{field_a}\" with "
"\"{field_b}\"."
msgstr "إعدادات اقتصاص غير صالحة. لا يمكنك دمج \"{field_a}\" مع \"{field_b}\"."
