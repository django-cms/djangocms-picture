#: apps.py:7
msgid "django CMS Picture"
msgstr "django CMS 이미지"

#: cms_plugins.py:23
msgid "Image"
msgstr "이미지"

#: cms_plugins.py:33 models.py:158
msgid "Attributes"
msgstr "속성"

#: cms_plugins.py:43
msgid "Cropping"
msgstr "자르기"

#: cms_plugins.py:51 models.py:189
msgid "Link"
msgstr "링크"

#: fields.py:110
msgid "Select a valid image source."
msgstr "유효한 이미지 소스를 선택하세요."

#: fields.py:111
msgid "Select an image from this source."
msgstr "이 소스에서 이미지를 선택하세요."

#: fields.py:144 forms.py:19 forms.py:53 models.py:97
msgid "Image source"
msgstr "이미지 소스"

#: models.py:45
msgid "Align left"
msgstr "왼쪽 정렬"

#: models.py:46
msgid "Align right"
msgstr "오른쪽 정렬"

#: models.py:47
msgid "Align center"
msgstr "가운데 정렬"

#: models.py:56
msgid "Default"
msgstr "기본값"

#: models.py:73
msgid "Open in new window"
msgstr "새 창에서 열기"

#: models.py:74
msgid "Open in same window"
msgstr "같은 창에서 열기"

#: models.py:75
msgid "Delegate to parent"
msgstr "상위 창에 위임"

#: models.py:76
msgid "Delegate to top"
msgstr "최상위 창에 위임"

#: models.py:80
msgid "Let settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES decide"
msgstr "settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES 설정에 따름"

#: models.py:81
msgid "Yes"
msgstr "예"

#: models.py:82
msgid "No"
msgstr "아니요"

#: models.py:91
msgid "Template"
msgstr "템플릿"

#: models.py:103
msgid "Image model"
msgstr "이미지 모델"

#: models.py:110
msgid "Image object ID"
msgstr "이미지 객체 ID"

#: models.py:121
msgid "Image source configuration"
msgstr "이미지 소스 구성"

#: models.py:127
msgid "Width"
msgstr "너비"

#: models.py:131
msgid "The image width as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "이미지 너비를 픽셀 단위 숫자로 입력합니다. 예: \"720\"(\"720px\" 아님)."

#: models.py:136
msgid "Height"
msgstr "높이"

#: models.py:140
msgid "The image height as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "이미지 높이를 픽셀 단위 숫자로 입력합니다. 예: \"720\"(\"720px\" 아님)."

#: models.py:145
msgid "Alignment"
msgstr "정렬"

#: models.py:149
msgid "Aligns the image according to the selected option."
msgstr "선택한 옵션에 따라 이미지를 정렬합니다."

#: models.py:152
msgid "Caption text"
msgstr "캡션 텍스트"

#: models.py:155
msgid "Provide a description, attribution, copyright or other information."
msgstr "설명, 저작자 표시, 저작권 또는 기타 정보를 입력하세요."

#: models.py:164
msgid "External URL"
msgstr "외부 URL"

#: models.py:168
msgid "Wraps the image in a link to an external URL."
msgstr "이미지를 외부 URL 링크로 감쌉니다."

#: models.py:171
msgid "Internal URL"
msgstr "내부 URL"

#: models.py:175
msgid "Wraps the image in a link to an internal (page) URL."
msgstr "이미지를 내부(페이지) URL 링크로 감쌉니다."

#: models.py:178
msgid "Link target"
msgstr "링크 대상"

#: models.py:184
msgid "Link attributes"
msgstr "링크 속성"

#: models.py:195
msgid "Automatic scaling"
msgstr "자동 크기 조정"

#: models.py:198
msgid "Uses the placeholder dimensions to automatically calculate the size."
msgstr "플레이스홀더 크기를 사용하여 크기를 자동으로 계산합니다."

#: models.py:203
msgid "Use original image"
msgstr "원본 이미지 사용"

#: models.py:206
msgid "Outputs the raw image without cropping."
msgstr "자르지 않은 원본 이미지를 출력합니다."

#: models.py:211
msgid "Crop image"
msgstr "이미지 자르기"

#: models.py:214
msgid ""
"Crops the image according to the thumbnail settings provided in the "
"template."
msgstr "템플릿에 지정된 썸네일 설정에 따라 이미지를 자릅니다."

#: models.py:217
msgid "Upscale image"
msgstr "이미지 확대"

#: models.py:220
msgid ""
"Upscales the image to the size of the thumbnail settings in the template."
msgstr "이미지를 템플릿의 썸네일 설정 크기까지 확대합니다."

#: models.py:223
msgid "Use responsive image"
msgstr "반응형 이미지 사용"

#: models.py:228
msgid ""
"Uses responsive image technique to choose better image to display based upon"
" screen viewport. This configuration only applies to uploaded images "
"(external pictures will not be affected). "
msgstr ""
"화면 뷰포트에 따라 더 적합한 이미지를 선택하도록 반응형 이미지 기법을 사용합니다. 이 설정은 업로드된 이미지에만 적용됩니다(외부 "
"이미지는 영향을 받지 않음). "

#: models.py:236
msgid "Thumbnail options"
msgstr "썸네일 옵션"

#: models.py:239
msgid ""
"Overrides width, height, and crop; scales up to the provided preset "
"dimensions."
msgstr "너비, 높이 및 자르기 설정을 재정의하고 지정된 프리셋 크기까지 확대합니다."

#: models.py:400
msgid "<file is missing>"
msgstr "<파일이 없습니다>"

#: models.py:507
msgid ""
"You have given both external and internal links. Only one option is allowed."
msgstr "외부 링크와 내부 링크를 모두 지정했습니다. 하나만 선택할 수 있습니다."

#: models.py:521
msgid ""
"You need to add either an image, or a URL linking to an external image."
msgstr "이미지 또는 외부 이미지로 연결되는 URL을 추가해야 합니다."

#: models.py:547
#, python-brace-format
msgid ""
"Invalid cropping settings. You cannot combine \"{field_a}\" with "
"\"{field_b}\"."
msgstr "잘못된 자르기 설정입니다. \"{field_a}\"와 \"{field_b}\"를 함께 사용할 수 없습니다."
