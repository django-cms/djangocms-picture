#: apps.py:7
msgid "django CMS Picture"
msgstr "Figura django CMS"

#: cms_plugins.py:23
msgid "Image"
msgstr "Imazhi"

#: cms_plugins.py:33 models.py:158
msgid "Attributes"
msgstr "Atributet"

#: cms_plugins.py:43
msgid "Cropping"
msgstr "Prerja"

#: cms_plugins.py:51 models.py:189
msgid "Link"
msgstr "Lidhja"

#: fields.py:110
msgid "Select a valid image source."
msgstr "Zgjidhni një burim të vlefshëm imazhesh."

#: fields.py:111
msgid "Select an image from this source."
msgstr "Zgjidhni një imazh nga ky burim."

#: fields.py:144 forms.py:19 forms.py:53 models.py:97
msgid "Image source"
msgstr "Burimi i imazhit"

#: models.py:45
msgid "Align left"
msgstr "Rreshto majtas"

#: models.py:46
msgid "Align right"
msgstr "Rreshto djathtas"

#: models.py:47
msgid "Align center"
msgstr "Rreshto në qendër"

#: models.py:56
msgid "Default"
msgstr "Parazgjedhja"

#: models.py:73
msgid "Open in new window"
msgstr "Hap në dritare të re"

#: models.py:74
msgid "Open in same window"
msgstr "Hap në të njëjtën dritare"

#: models.py:75
msgid "Delegate to parent"
msgstr "Delegoji prindit"

#: models.py:76
msgid "Delegate to top"
msgstr "Delegoji kreut"

#: models.py:80
msgid "Let settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES decide"
msgstr "Lëre settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES të vendosë"

#: models.py:81
msgid "Yes"
msgstr "Po"

#: models.py:82
msgid "No"
msgstr "Jo"

#: models.py:91
msgid "Template"
msgstr "Shablloni"

#: models.py:103
msgid "Image model"
msgstr "Modeli i imazhit"

#: models.py:110
msgid "Image object ID"
msgstr "ID-ja e objektit të imazhit"

#: models.py:121
msgid "Image source configuration"
msgstr "Konfigurimi i burimit të imazhit"

#: models.py:127
msgid "Width"
msgstr "Gjerësia"

#: models.py:131
msgid "The image width as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "Gjerësia e imazhit si numër pikselësh. Shembull: \"720\", jo \"720px\"."

#: models.py:136
msgid "Height"
msgstr "Lartësia"

#: models.py:140
msgid "The image height as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "Lartësia e imazhit si numër pikselësh. Shembull: \"720\", jo \"720px\"."

#: models.py:145
msgid "Alignment"
msgstr "Rreshtimi"

#: models.py:149
msgid "Aligns the image according to the selected option."
msgstr "Rreshton imazhin sipas opsionit të zgjedhur."

#: models.py:152
msgid "Caption text"
msgstr "Teksti i diçiturës"

#: models.py:155
msgid "Provide a description, attribution, copyright or other information."
msgstr ""
"Jepni një përshkrim, atribut, të drejtë autori ose informacion tjetër."

#: models.py:164
msgid "External URL"
msgstr "URL e jashtme"

#: models.py:168
msgid "Wraps the image in a link to an external URL."
msgstr "E mbështjell imazhin me një lidhje drejt një URL-je të jashtme."

#: models.py:171
msgid "Internal URL"
msgstr "URL e brendshme"

#: models.py:175
msgid "Wraps the image in a link to an internal (page) URL."
msgstr ""
"E mbështjell imazhin me një lidhje drejt një URL-je të brendshme (faqeje)."

#: models.py:178
msgid "Link target"
msgstr "Objektivi i lidhjes"

#: models.py:184
msgid "Link attributes"
msgstr "Atributet e lidhjes"

#: models.py:195
msgid "Automatic scaling"
msgstr "Shkallëzimi automatik"

#: models.py:198
msgid "Uses the placeholder dimensions to automatically calculate the size."
msgstr ""
"Përdor përmasat e vendmbajtësit për të llogaritur automatikisht madhësinë."

#: models.py:203
msgid "Use original image"
msgstr "Përdor imazhin origjinal"

#: models.py:206
msgid "Outputs the raw image without cropping."
msgstr "Shfaq imazhin e papërpunuar pa prerje."

#: models.py:211
msgid "Crop image"
msgstr "Prit imazhin"

#: models.py:214
msgid ""
"Crops the image according to the thumbnail settings provided in the "
"template."
msgstr "E pret imazhin sipas cilësimeve të miniaturës të dhëna në shabllon."

#: models.py:217
msgid "Upscale image"
msgstr "Zmadho imazhin"

#: models.py:220
msgid ""
"Upscales the image to the size of the thumbnail settings in the template."
msgstr ""
"E zmadhon imazhin në madhësinë e cilësimeve të miniaturës në shabllon."

#: models.py:223
msgid "Use responsive image"
msgstr "Përdor imazh reagues"

#: models.py:228
msgid ""
"Uses responsive image technique to choose better image to display based upon"
" screen viewport. This configuration only applies to uploaded images "
"(external pictures will not be affected). "
msgstr ""
"Përdor teknikën e imazhit reagues për të zgjedhur imazhin më të përshtatshëm"
" sipas pamjes së ekranit. Ky konfigurim zbatohet vetëm për imazhet e "
"ngarkuara (imazhet e jashtme nuk ndikohen). "

#: models.py:236
msgid "Thumbnail options"
msgstr "Opsionet e miniaturës"

#: models.py:239
msgid ""
"Overrides width, height, and crop; scales up to the provided preset "
"dimensions."
msgstr ""
"Anashkalon gjerësinë, lartësinë dhe prerjen; zmadhon deri në përmasat e "
"dhëna të paracaktuara."

#: models.py:400
msgid "<file is missing>"
msgstr "<skedari mungon>"

#: models.py:507
msgid ""
"You have given both external and internal links. Only one option is allowed."
msgstr ""
"Keni dhënë njëkohësisht lidhje të jashtme dhe të brendshme. Lejohet vetëm "
"një opsion."

#: models.py:521
msgid ""
"You need to add either an image, or a URL linking to an external image."
msgstr ""
"Duhet të shtoni një imazh ose një URL që lidhet me një imazh të jashtëm."

#: models.py:547
#, python-brace-format
msgid ""
"Invalid cropping settings. You cannot combine \"{field_a}\" with "
"\"{field_b}\"."
msgstr ""
"Cilësime të pavlefshme prerjeje. Nuk mund të kombinoni \"{field_a}\" me "
"\"{field_b}\"."
