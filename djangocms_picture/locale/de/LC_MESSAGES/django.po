#: apps.py:7
msgid "django CMS Picture"
msgstr "django CMS Bild"

#: cms_plugins.py:23
msgid "Image"
msgstr "Bild"

#: cms_plugins.py:33 models.py:158
msgid "Attributes"
msgstr "Attribute"

#: cms_plugins.py:43
#| msgid "Crop image"
msgid "Cropping"
msgstr "Zuschnitt"

#: cms_plugins.py:51 models.py:189
msgid "Link"
msgstr "Link"

#: fields.py:110
msgid "Select a valid image source."
msgstr "Wählen Sie eine gültige Bildquelle aus."

#: fields.py:111
msgid "Select an image from this source."
msgstr "Wählen Sie ein Bild aus dieser Quelle aus."

#: fields.py:144 forms.py:19 forms.py:53 models.py:97
msgid "Image source"
msgstr "Bildquelle"

#: models.py:45
msgid "Align left"
msgstr "Links ausrichten"

#: models.py:46
msgid "Align right"
msgstr "Rechts ausrichten"

#: models.py:47
msgid "Align center"
msgstr "Zentriert ausrichten"

#: models.py:56
msgid "Default"
msgstr "Standard"

#: models.py:73
msgid "Open in new window"
msgstr "In neuem Fenster öffnen"

#: models.py:74
msgid "Open in same window"
msgstr "Im gleichen Fenster öffnen"

#: models.py:75
msgid "Delegate to parent"
msgstr "Zum nächsten Fenster delegieren"

#: models.py:76
msgid "Delegate to top"
msgstr "Zum obersten Fenster delegieren"

#: models.py:80
msgid "Let settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES decide"
msgstr ""
"Überlasse die Entscheidung settings.DJANGOCMS_PICTURE_RESPONSIVE_IMAGES"

#: models.py:81
msgid "Yes"
msgstr "Ja"

#: models.py:82
msgid "No"
msgstr "Nein"

#: models.py:91
msgid "Template"
msgstr "Template"

#: models.py:103
#| msgid "Image"
msgid "Image model"
msgstr "Bildmodell"

#: models.py:110
msgid "Image object ID"
msgstr "Bildobjekt-ID"

#: models.py:121
msgid "Image source configuration"
msgstr "Konfiguration der Bildquelle"

#: models.py:127
msgid "Width"
msgstr "Breite"

#: models.py:131
msgid "The image width as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "Die Bildbreite als Zahl in Pixel. Beispiel: \"720\" und nicht \"720px\""

#: models.py:136
msgid "Height"
msgstr "Höhe"

#: models.py:140
msgid "The image height as number in pixels. Example: \"720\" and not \"720px\"."
msgstr "Die Bildhöhe als Zahl in Pixel. Beispiel: \"720\" und nicht \"720px\"."

#: models.py:145
msgid "Alignment"
msgstr "Ausrichtung"

#: models.py:149
msgid "Aligns the image according to the selected option."
msgstr "Richtet das Bild an der ausgewählten Option aus."

#: models.py:152
msgid "Caption text"
msgstr "Legendentext"

#: models.py:155
msgid "Provide a description, attribution, copyright or other information."
msgstr ""
"Angaben wie Beschreibung, Zuschreibung, Copyright oder andere Informationen."

#: models.py:164
msgid "External URL"
msgstr "Externe URL"

#: models.py:168
msgid "Wraps the image in a link to an external URL."
msgstr "Umschliesst das Bild mit einem Link zu einer externen URL."

#: models.py:171
msgid "Internal URL"
msgstr "Interne URL"

#: models.py:175
msgid "Wraps the image in a link to an internal (page) URL."
msgstr "Umschliesst das Bild mit einem Link zu einer internen (Seiten-) URL."

#: models.py:178
msgid "Link target"
msgstr "Linkverweis"

#: models.py:184
msgid "Link attributes"
msgstr "Linkattribute"

#: models.py:195
msgid "Automatic scaling"
msgstr "Automatische Skalierung"

#: models.py:198
msgid "Uses the placeholder dimensions to automatically calculate the size."
msgstr ""
"Nutzt die Dimensionen des Platzhalters um die Grösse automatisch zu "
"berechnen."

#: models.py:203
msgid "Use original image"
msgstr "Originalgrösse verwenden"

#: models.py:206
msgid "Outputs the raw image without cropping."
msgstr "Gibt das RAW-Bild aus, ohne dieses zuzuschneiden."

#: models.py:211
msgid "Crop image"
msgstr "Bild zuschneiden"

#: models.py:214
msgid ""
"Crops the image according to the thumbnail settings provided in the "
"template."
msgstr ""
"Schneidet das Bild entsprechend der Grösse der Thumbnail-Einstellungen in "
"der Vorlage zu."

#: models.py:217
msgid "Upscale image"
msgstr "Bild skalieren"

#: models.py:220
msgid ""
"Upscales the image to the size of the thumbnail settings in the template."
msgstr ""
"Skaliert das Bild entsprechend der Grösse der Thumbnail-Einstellungen in der"
" Vorlage."

#: models.py:223
msgid "Use responsive image"
msgstr "Nutze responsive Bilder"

#: models.py:228
msgid ""
"Uses responsive image technique to choose better image to display based upon"
" screen viewport. This configuration only applies to uploaded images "
"(external pictures will not be affected). "
msgstr ""
"Nutzt responsive Bild-Technologie um die Bildgrösse je nach Viewport "
"automatisch zu bestimmen. Diese Konfiguration ist nur für hochgeladene "
"Bilder gültig (externe Bilder werden nicht beeinflusst)."

#: models.py:236
msgid "Thumbnail options"
msgstr "Thumbnail-Optionen"

#: models.py:239
msgid ""
"Overrides width, height, and crop; scales up to the provided preset "
"dimensions."
msgstr ""
"Überschreibt Breite, Höhe, Zuschneiden und Skalierung mit den gegebenen "
"Voreinstellungen."

#: models.py:400
msgid "<file is missing>"
msgstr "<datei nicht vorhanden>"

#: models.py:507
msgid ""
"You have given both external and internal links. Only one option is allowed."
msgstr ""
"Es wurden ein externer und interner Link definiert. Nur eine Option ist "
"möglich."

#: models.py:521
msgid ""
"You need to add either an image, or a URL linking to an external image."
msgstr ""
"Es muss entweder ein Bild oder ein externer Link zu einem Bild hinzugefügt "
"werden."

#: models.py:547
#, python-brace-format
msgid ""
"Invalid cropping settings. You cannot combine \"{field_a}\" with "
"\"{field_b}\"."
msgstr ""
"Die Zuschnitts Auswahl ist nicht erlaubt. \"{field_a}\" und \"{field_b}\" "
"können nicht kombiniert werden."
